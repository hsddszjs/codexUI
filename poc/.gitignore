# 真 API key,不入库
config/auth.json

# 容器侧 sidecar 的 node_modules
sidecar/node_modules/
server/node_modules/
*.log

# 沙箱专属 CA(每个沙箱不一样)
sandbox-ca.crt

# 容器运行时挂载的 host 目录(每个用户的 codex-home + workspace,
# 包含 sessions jsonl + 真 API key,不应该入库)
state/

# 仓库根 .gitignore 把 package.json / package-lock.json 全局排除了,
# poc 子树需要反向解禁
!package.json
!package-lock.json
